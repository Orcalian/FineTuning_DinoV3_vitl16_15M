### =====================================================================
### DINOv3 ViT-L/16 — finetuning SSL facon DinoBloom (VALIDATION DU PORTAGE)
### - crops locaux actives (local_crops_number: 8) : DINOv3 l'exige (assertion >0)
### - gram anchoring desactive (use_loss: false)        <- SSL de base
### - fp8 / compile desactives                          <- debug d'abord
### - dataset = HistoFolder (tes images)
### Derivee de dinov3_vit7b16_pretrain.yaml, dimensionnee pour vit_large (~300M params).
### =====================================================================
MODEL:
  META_ARCHITECTURE: SSLMetaArch
  DEVICE: cuda
  WEIGHTS: ''
  DTYPE: float32
compute_precision:
  param_dtype: bf16
  reduce_dtype: fp32
  sharding_strategy: SHARD_GRAD_OP
dino:
  loss_weight: 1.0
  global_ignore_diagonal: true
  head_n_prototypes: 131072       # vit_large (small: 65536, 7B: 262144)
  head_bottleneck_dim: 384        # vit_large (small: 256)
  head_norm_last_layer: false
  head_nlayers: 3
  head_hidden_dim: 4096           # vit_large (small: 2048, 7B: 8192)
  koleo_loss_weight: 0.1
  koleo_loss_distributed: false
  koleo_topk: 1
  koleo_distributed_replicas: 0
  koleo_distributed_loss_group_size: null
  force_weight_norm: false
ibot:
  loss_weight: 1.0
  mask_sample_probability: 0.5
  mask_ratio_min_max:
  - 0.1
  - 0.5
  mask_random_circular_shift: false
  force_masking_even_with_zero_weight: false
  separate_head: true
  head_n_prototypes: 131072       # vit_large
  head_bottleneck_dim: 384
  head_norm_last_layer: false
  head_nlayers: 3
  head_hidden_dim: 4096
gram:
  use_loss: false                 # gram anchoring OFF (nouveaute v3, pas dans DinoBloom)
  compute_stats: false
train:
  batch_size_per_gpu: 160         # 160x4=640 global (~50 Go estime depuis 10 Go a batch 32)
  dataset_path: HistoFolder:root=/mnt/beegfs02/scratch/a_claveau/patch_lists_masked
  saveckp_freq: 20
  seed: 0
  num_workers: 10
  OFFICIAL_EPOCH_LENGTH: 500      # 500 x epochs = nb d'iterations
  monitor_gradient_norm: false
  chunk_schedule: []
  cache_dataset: false
  use_teacher_head: true
  learn_from_teacher_tokens: false
  centering: sinkhorn_knopp
  checkpointing: true             # activation checkpointing (utile au scale)
  checkpointing_full: false
  compile: false                  # OFF pour debugger le portage (on activera apres)
  cudagraphs: false
  cell_augmentation: false
  cell_augmentation_type: hpa
  sharded_eval_checkpoint: true
student:
  arch: vit_large                 # <<< petit modele pour valider le pipeline
  patch_size: 16
  drop_path_rate: 0.4             # 0.4 pour vit_large
  layerscale: 1.0e-05
  patch_drop: 0.0
  pretrained_weights: ''          # NON utilise a l'entrainement (sert aux evals)
  # >>> C'est CE champ qui initialise depuis le backbone pre-entraine LVD-1689M.
  # Genere par prepare_weights_dinov3_vits.py (format {"teacher": {backbone....}}).
  resume_from_teacher_chkpt: /home/a_claveau/dinov3_vitl16_teacher_init.pth
  ffn_layer: mlp                  # vit_small officiel = MLP (swiglu = pour le 7B)
  ffn_ratio: 4                    # vit_small : ffn_ratio 4
  qkv_bias: true                  # vit_small officiel = true (7B = false)
  proj_bias: true
  ffn_bias: true
  norm_layer: layernormbf16       # comme le vit_small officiel
  n_storage_tokens: 4             # 4 register tokens (architecture v3)
  untie_cls_and_patch_norms: false
  untie_global_and_local_cls_norm: false
  mask_k_bias: true
  in_chans: 3
  pos_embed_type: rope            # RoPE : pas de pos_embed appris -> pas de mismatch taille
  pos_embed_rope_base: 100
  pos_embed_rope_min_period: null
  pos_embed_rope_max_period: null
  pos_embed_rope_normalize_coords: separate
  pos_embed_rope_shift_coords: null
  pos_embed_rope_jitter_coords: null
  pos_embed_rope_rescale_coords: 2
  pos_embed_rope_dtype: fp32
  fp8_enabled: false              # fp8 OFF (reserve au 7B)
  fp8_filter: blocks
teacher:
  momentum_teacher: null
  final_momentum_teacher: null
  warmup_teacher_temp: null
  teacher_temp: null
  warmup_teacher_temp_epochs: null
  in_chans: 3
distillation:
  enabled: false
  full_cfg_path: ''
  checkpoint_path: ''
multidistillation:
  enabled: false
hrft:
  enabled: false
  checkpoint_path: ''
optim:
  epochs: 232                       # 8 x 500 = 4000 iterations (comme DinoBloom)
  optimizer: adamw
  weight_decay: null
  weight_decay_end: null
  lr: null
  warmup_epochs: null
  min_lr: null
  schedule_trunc_extra: null
  clip_grad: 3.0
  freeze_last_layer_epochs: null
  scaling_rule: sqrt_wrt_1024
  patch_embed_lr_mult: 0.2
  dino_head_wd_multiplier: 1.0
  layerwise_decay: 0.9
  multi_tensor_optim: true
  dump_fsdp_weights_path: ''
  adamw_beta1: 0.9
  adamw_beta2: 0.999
crops:
  global_crops_scale:
  - 0.32
  - 1.0
  local_crops_number: 8           # DINOv3 exige >0 (assertion). Recette DinoBloom non applicable ici.
  local_crops_scale:
  - 0.05
  - 0.32
  global_crops_size: 224          # 224 comme DinoBloom (multiple de 16)
  local_crops_size: 96
  localcrops_subset_of_globalcrops: false
  share_color_jitter: false
  horizontal_flips: false
  rgb_mean:
  - 0.485
  - 0.456
  - 0.406
  rgb_std:
  - 0.229
  - 0.224
  - 0.225
checkpointing:
  period: 2000                     # sauvegarde tous les 500 it (securite)
  max_to_keep: 5
  keep_every: 2000
schedules:
  lr:
    start: 0
    peak: 1.0e-04                 # LR de depart raisonnable pour small
    end: 1.0e-06
    warmup_epochs: 1
    freeze_last_layer_epochs: 1
  weight_decay:
    start: 0.04
    peak: 0.04
    end: 0.4
    warmup_epochs: 0
  teacher_temp:
    start: 0.04
    peak: 0.07
    end: 0.07
    warmup_epochs: 1
  momentum:
    start: 0.994
    peak: 1.0
    end: 1.0
    warmup_epochs: 0
